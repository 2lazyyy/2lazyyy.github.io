---
import BaseLayout from "../layouts/Base.astro";
---

<BaseLayout title="Messages | 2lazy's Cyber blog!!">
  <main class="messages-page">
    <section class="comment-box" aria-labelledby="messages-title">
      <h1 id="messages-title">Messages</h1>
      <p id="messages-status" class="comment-note" role="status">Loading messages...</p>
      <ul id="messages-list" class="comment-list" aria-live="polite"></ul>
    </section>
  </main>
</BaseLayout>

<script>
  import { createClient } from "@supabase/supabase-js";

  const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
  const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
  const supabase = supabaseUrl && supabaseAnonKey
    ? createClient(supabaseUrl, supabaseAnonKey)
    : null;
  const messageList = document.querySelector<HTMLUListElement>("#messages-list");
  const messageStatus = document.querySelector<HTMLParagraphElement>("#messages-status");

  const loadMessages = async () => {
    if (!supabase) {
      if (messageStatus) messageStatus.textContent = "Messages are unavailable right now.";
      return;
    }

    const { data, error } = await supabase
      .from("comments")
      .select("name, message, created_at")
      .order("created_at", { ascending: false });

    if (error) {
      if (messageStatus) messageStatus.textContent = "Could not load messages.";
      return;
    }

    if (messageList) {
      messageList.replaceChildren();
      for (const message of data ?? []) {
        const item = document.createElement("li");
        const author = document.createElement("strong");
        const content = document.createElement("p");
        const date = document.createElement("time");

        author.textContent = message.name;
        content.textContent = message.message;
        date.textContent = new Date(message.created_at).toLocaleString();
        date.dateTime = message.created_at;
        item.append(author, date, content);
        messageList.append(item);
      }
    }

    if (messageStatus) {
      messageStatus.textContent = data?.length ? "" : "No messages yet.";
    }
  };

  loadMessages();
</script>
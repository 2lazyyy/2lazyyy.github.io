---
import BaseLayout from "../layouts/Base.astro";
---

<BaseLayout
  title="Search | 2lazy"
  description="Search the 2lazy technical blog."
>
  <section class="mx-auto max-w-4xl px-6 py-16">
    <h1 class="text-4xl font-bold">
      Search
    </h1>

    <div class="mt-8">
      <link
        href="/pagefind/pagefind-ui.css"
        rel="stylesheet"
      />

      <script
        src="/pagefind/pagefind-ui.js"
        type="text/javascript"
      ></script>

      <div id="search"></div>

      <script>
        new (window as any).PagefindUI({
          element: "#search",
          showSubResults: true
        });
      </script>
    </div>
  </section>
</BaseLayout>